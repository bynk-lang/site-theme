---
// Starlight's own footer (the edit link, the previous and next pages), then
// the Bynk strip that ends every page on every Bynk site: the mark, where
// Bynk is, and the site's licence, set with the plugin's `licence` option.
import Default from "@astrojs/starlight/components/Footer.astro";
import themeConfig from "virtual:bynk-site-theme/config";

const licence = themeConfig.licence;
---

<Default />
<div class="bynk-footer">
  <p class="where">
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="1" y="1" width="22" height="10" rx="3" fill="#f2b134"></rect>
      <rect x="1" y="13" width="10" height="10" rx="3" fill="#3cc4a6"></rect>
      <rect x="13.5" y="13.5" width="9" height="9" rx="2.5" fill="#1d2825" stroke="#5f7a70"></rect>
    </svg>
    Bynk is pre-1.0 and evolving in small, spec-first increments.
  </p>
  {
    licence.length > 0 && (
      <p class="licence">
        {licence.map((part, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            {part.href ? <a href={part.href}>{part.label}</a> : <span>{part.label}</span>}
          </>
        ))}
      </p>
    )
  }
</div>

<style>
  .bynk-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--bynk-space-4) var(--bynk-space-6);
    margin-top: calc(2 * var(--bynk-space-4));
    padding-top: var(--bynk-space-6);
    border-top: 1px solid var(--bynk-line);
    font-size: var(--sl-text-sm);
    color: var(--bynk-ink-muted);
  }
  .bynk-footer p {
    margin: 0;
  }
  .where {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .mark {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
  .licence a {
    color: var(--bynk-ink-muted);
  }
  .licence a:hover {
    color: var(--bynk-accent);
  }
</style>
