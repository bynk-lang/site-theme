---
// The Bynk header, as the site mockups draw it: the wordmark and the site's
// sections on the left, then search, the playground, the social links and the
// theme menu on the right. The current section is marked in amber, as the
// design system marks an active tab. Below Starlight's `md` breakpoint the
// sections and the right-hand group fold away, as Starlight's own do, and the
// mobile menu carries the rest.
//
// Search opens with `/` as well as Starlight's Ctrl/⌘ K, unless focus is in a
// field or a modifier is held.
import config from "virtual:starlight/user-config";
import themeConfig from "virtual:bynk-site-theme/config";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

import { navFor, PLAYGROUND } from "../nav.js";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";

const links = navFor(Astro.url.pathname, { origin: themeConfig.origin });
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="bynk-nav sl-hidden md:sl-flex print:hidden" aria-label="Site">
    {
      links.map((link) => (
        <a href={link.href} {...(link.current ? { "aria-current": "page" } : {})}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <a class="playground" href={PLAYGROUND.href} rel="noopener">
      {PLAYGROUND.label}
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7.5 8.5"></path>
      </svg>
    </a>
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<script>
  // `/` opens search, as on many documentation sites. Starlight's own handler
  // only listens for Ctrl/⌘ K.
  const typing = (el: Element | null) =>
    !!el &&
    (el instanceof HTMLInputElement ||
      el instanceof HTMLTextAreaElement ||
      el instanceof HTMLSelectElement ||
      (el as HTMLElement).isContentEditable);
  window.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || typing(document.activeElement)) return;
    const open = document.querySelector<HTMLButtonElement>("button[data-open-modal]");
    if (!open || document.querySelector("dialog[open]")) return;
    e.preventDefault();
    open.click();
  });
</script>

<style>
  .bynk-nav {
    gap: 0.25rem;
    align-items: center;
  }
  .bynk-nav a,
  .playground {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--bynk-ink);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .bynk-nav a {
    padding-inline: 0.625rem;
  }
  .bynk-nav a:hover,
  .playground:hover {
    color: var(--bynk-accent);
  }
  .bynk-nav a[aria-current] {
    color: var(--bynk-brand-text);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--bynk-brand-text);
  }
  .playground {
    gap: 0.375rem;
  }
  .playground svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    /* Search takes the free space and sits at its end, after the sections. */
    .search {
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: "";
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      .search :global(site-search) {
        width: 100%;
        max-width: 22rem;
      }
    }
  }
</style>
