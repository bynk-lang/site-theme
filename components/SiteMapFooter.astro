---
// The site map, in four columns, as the home page's footer draws it: Learn,
// Examples, Reference and Project. The page footer (SiteFooter.astro) shows
// it on the pages the plugin's `siteMap` option names, outside <main>.
import themeConfig from "virtual:bynk-site-theme/config";
import { siteMapFor } from "../nav.js";

const columns = siteMapFor({ origin: themeConfig.origin });
---

<nav class="bynk-site-map not-content" aria-label="Site map">
  {
    columns.map((column) => (
      <div>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href} {...(link.external ? { rel: "noopener" } : {})}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .bynk-site-map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--bynk-space-6);
    padding-top: calc(2 * var(--bynk-space-4));
    border-top: 1px solid var(--bynk-line);
  }
  h2 {
    margin: 0 0 var(--bynk-space-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bynk-ink-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--bynk-space-2);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--bynk-ink);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  a:hover {
    color: var(--bynk-accent);
  }
</style>
